---
interface Props {
  href: string;
  label: string;
  mobile?: boolean;
  data_i18n: string;
}

const { mobile = false, href, label,data_i18n } = Astro.props;
---

<!-- class="nav-link relative py-2 font-medium transition-colors duration-300" -->
<a
  href={href}
class:list={[
"nav-link relative font-medium transition-colors duration-300",
mobile && "nav-link--mobile",
]}
  data-nav-link
  data-i18n={data_i18n}
>
  {label}
</a>
