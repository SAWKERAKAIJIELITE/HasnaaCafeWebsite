---
import logo from "@/assets/demo/logo.png";

interface Props {
  light?: boolean;
}

const { light = false } = Astro.props;
---

<!-- class={`text-2xl font-black tracking-wide ${
    light ? "text-white" : "text-slate-900"
  }`} -->
<a href="#home" class="inline-flex items-center gap-3 shrink-0">
  <img
    src={logo.src}
    alt="Hasnaa Coffee"
    width={1000}
    height={1000}
    class:list={[
      "overflow-visible h-26 w-auto object-contain -my-4",
      light && "brightness-0 invert",
    ]}
  />

  <!-- <span
    class="mt-1
