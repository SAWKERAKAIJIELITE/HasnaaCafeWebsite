---
import { localize } from "@/i18n/localize";
import { navigation } from "@/data/navigation";
---

<a
  href="#contact"
  class="rounded-lg
        bg-amber-500
        px-6
        py-3
        font-semibold
        text-white
        transition
        hover:bg-amber-600"
>
  <!-- data-i18n="navbar.contactUs" -->
  {localize(navigation.find(n=>n.label.en=="Contact").label, Astro.locals.language)}
</a>
