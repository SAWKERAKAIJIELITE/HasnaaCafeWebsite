---
import {navigation} from "@/data/navigation";
---

<!-- <header
  class="sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur"
> -->
<header class="fixed top-0 left-0 z-50 w-full">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6">
    <!-- <a href="#home" class="text-2xl font-bold tracking-tight"> LOGO </a> -->
    <a
      href="#home"
      class="text-3xl font-black text-white"
      aria-label="Go to homepage"
    >
      LOGO
    </a>
    <!-- <nav class="hidden md:block" aria-label="Main navigation"> -->
    <nav class="hidden lg:block">
      <ul class="flex gap-10">
        {
          navigation.map((link) => (
            <li>
              <a
                href={link.href}
                // class="text-sm font-medium text-slate-700 transition-colors hover:text-black"
                class="font-medium text-white transition hover:text-amber-400"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- <a
      href="#contact"
      class="rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-700"
    > -->
    <a
      href="#contact"
      class="rounded-lg bg-amber-500 px-6 py-3 font-semibold text-white transition hover:bg-amber-600"
    >
      Contact Us
    </a>
  </div>
</header>
