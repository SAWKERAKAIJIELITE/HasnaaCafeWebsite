---
import type { WorkingHour } from "@/types/contact";

interface Props {
  hours: WorkingHour[];
}

const { hours } = Astro.props;
---

<div class="rounded-3xl border border-slate-200 bg-white p-8">
  <h3 class="text-lg font-black text-slate-900">Business Hours</h3>

  <div class="mt-6 space-y-4">
    {
      hours.map((hour) => (
        <div class="flex items-center justify-between border-b border-slate-100 pb-3 last:border-none last:pb-0">
          <span class="text-slate-600">{hour.day}</span>

          <span class="font-semibold text-slate-900">{hour.time}</span>
        </div>
      ))
    }
  </div>
</div>
