---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { eyebrow, title, description, align = "left" } = Astro.props;

const alignment = align === "center" ? "mx-auto text-center" : "text-left";
---

<div class={`max-w-3xl ${alignment}`}>
  {
    eyebrow && (
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.35em] text-amber-500">
        {eyebrow}
      </p>
    )
  }

  <h2 class="text-4xl font-black leading-tight md:text-5xl">
    {title}
  </h2>

  {
    description && (
      <p class="mt-6 text-lg leading-8 text-slate-600">{description}</p>
    )
  }
</div>
