---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { eyebrow, title, description, align = "left" } = Astro.props;

const alignment = align === "center" ? "text-center mx-auto" : "";
---

<div class={`max-w-2xl ${alignment}`}>
  {
    eyebrow && (
      <p class="mb-3 text-sm font-bold uppercase tracking-[0.3em] text-amber-600">
        {eyebrow}
      </p>
    )
  }

  <h2 class="text-4xl font-black leading-tight text-slate-900 md:text-5xl">
    {title}
  </h2>

  {
    description && (
      <p class="mt-6 text-lg leading-8 text-slate-600">{description}</p>
    )
  }
</div>
