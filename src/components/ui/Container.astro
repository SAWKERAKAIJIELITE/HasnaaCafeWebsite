---
interface Props {
  size?: "sm" | "md" | "lg" | "xl" | "full";
  class?: string;
}

const { size = "xl", class: className = "" } = Astro.props;

const sizes = {
  sm: "max-w-3xl",
  md: "max-w-5xl",
  lg: "max-w-6xl",
  xl: "max-w-7xl",
  full: "max-w-none",
};
---


<div class={`mx-auto w-full px-6 lg:px-8 ${sizes[size]} ${className}`}>
  <slot />
</div>
