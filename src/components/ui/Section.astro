---
interface Props {
  id?: string;
  class?: string;
  spacing?: "sm" | "md" | "lg" | "xl" | "none";
}

const { id, class: className = "", spacing = "lg" } = Astro.props;

const spacings = {
  none: "",
  sm: "py-12",
  md: "py-20",
  lg: "py-28",
  xl: "py-36",
};
---


<section id={id} class={`${spacings[spacing]} ${className}`}>
  <slot />
</section>

