---
interface Props {
  value: number;
  suffix?: string;
  label: string;
}
import { localize } from "@/i18n/localize";

const { value, suffix = "+", label } = Astro.props;
---

<div
  class="stat-card rounded-2xl bg-white p-6 shadow-xl ring-1 ring-slate-200 transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl"
>
  <p
    class="counter text-4xl font-black text-amber-600"
    data-target={value}
    data-suffix={suffix}
  >
    0
  </p>

  <p
    class="mt-2 text-sm font-semibold uppercase tracking-widest text-slate-500"
  >
    {localize(label, Astro.locals.language)}
  </p>
</div>
