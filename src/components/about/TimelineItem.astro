<div class="relative flex-1 pb-16 lg:pb-0 group">
  {
    !item.current && (
      <div class="absolute left-[15px] top-8 h-full w-0.5 bg-[#3c9339] lg:hidden " />
    )
  }

  <!-- Desktop connector -->
  {
    !item.current && (
      <div class="absolute left-8 right-0 top-[15px] hidden h-0.5 bg-[#3c9339] lg:block" />
    )
  }

  <!-- Top Row -->
  <div class="flex items-center lg:flex-col">
    <!-- Dot -->
    <div
      class="z-10
                flex
                h-8
                w-8
                items-center
                justify-center
                rounded-full
                border-4
                border-[#005826]
                bg-white
                transition-all
                duration-300
                group-hover:scale-110
                shrink-0"
    >
      {
        item.current ? (
          <div class="h-3 w-3 rounded-full bg-[#005826]" />
        ) : (
          <div class="h-2 w-2 rounded-full bg-[#005826]/30" />
        )
      }
    </div>

    <!-- Year -->
    <p class="ml-5 text-3xl font-black text-amber-600 lg:ml-0 lg:mt-6">
      {localize(item.year, Astro.locals.language)}
    </p>
  </div>

  <!-- Content -->
  <div class="ml-14 mt-6 lg:ml-0 lg:text-center">
    <h3 class="text-xl font-bold text-slate-900">{localize(item.title, Astro.locals.language)}</h3>
    <p class="mt-3 leading-7 text-slate-600">{localize(item.description, Astro.locals.language)}</p>
  </div>
</div>
