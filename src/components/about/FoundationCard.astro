---
interface Props {
  title: string;
  icon: any;
  description?: string;
  values?: string[];
}

const { title, icon: Icon, description, values } = Astro.props;
---

<article
  class="group
    flex
    h-full
    flex-col
    rounded-2xl
    border
    border-slate-200
    bg-white
    p-8
    transition-all
    duration-300
    ease-out
    hover:-translate-y-2
    hover:border-amber-400
    hover:shadow-[0_24px_60px_rgba(245,158,11,0.18)]"
  data-animate="fade-up"
>
  <div
    class="mb-6
            flex
            h-16
            w-16
            items-center
            justify-center
            rounded-2xl
            bg-amber-100
            transition-all
            duration-300
            group-hover:bg-amber-500
            group-hover:rotate-6
            group-hover:scale-110"
  >
    <Icon
      size={34}
      class="text-amber-600 transition-colors duration-300 group-hover:text-white"
    />
  </div>

  <h3 class="mb-4 text-2xl font-bold text-slate-900">
    {title}
  </h3>

  {description && <p class="flex-1 leading-8 text-slate-600">{description}</p>}

  {
    values && (
      <div class="mt-4 flex flex-wrap gap-3">
        {values.map((value) => (
          <span
            class="
                        rounded-full
                        bg-amber-100

                        px-4
                        py-2

                        text-sm
                        font-medium
                        text-amber-700
                            "
          >
            {value}
          </span>
        ))}
      </div>
    )
  }
</article>
