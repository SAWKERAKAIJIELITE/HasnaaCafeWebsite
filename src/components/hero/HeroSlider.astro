---
// import { heroSlides } from "@/data/hero";
import { getHero } from "@/services/home/hero.service";

const slides = await getHero();
import HeroSlide from "./HeroSlide.astro";
import { ChevronLeft, ChevronRight } from "lucide-astro";
---

<div class="embla" id="hero-slider">
  <div class="embla__viewport">
    <div class="embla__container">
      {slides.map((slide, index) => <HeroSlide slide={slide} index={index} />)}
    </div>
  </div>
  <button
    class="hero-arrow hero-arrow--prev"
    data-prev
    aria-label="Previous slide"
  >
    <!-- ← -->
    <ChevronLeft size={26} strokeWidth={2.5} />
  </button>

  <button class="hero-arrow hero-arrow--next" data-next aria-label="Next slide">
    <!-- → -->
    <ChevronRight size={26} strokeWidth={2.5} />
  </button>

  <div class="hero-progress">
    <div class="hero-progress__bar" data-progress></div>
  </div>

  <div class="hero-dots" data-dots></div>
</div>
