---
import type { HeroSlide as HeroSlideType } from "@/data/hero";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { localize } from "@/i18n/localize";

interface Props {
  slide: HeroSlideType;
  index: number;
}

const { slide, index } = Astro.props;
---

<div class="embla__slide relative min-h-screen">
  {
    slide.mediaType === "image" && (
      <img
        src={slide.media}
        alt={slide.title.en}
        // width={slide.media.width}
        // height={slide.media.height}
        loading={index === 0 ? "eager" : "lazy"}
        fetchpriority={index === 0 ? "high" : "auto"}
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-center"
      />
    )
  }
  {
    slide.mediaType === "video" && (
      <video
        autoplay
        muted
        loop
        playsinline
        class="absolute inset-0 h-full w-full object-cover object-center"
      >
        <source src={slide.media} />
      </video>
    )
  }

  <div class="absolute inset-0 bg-black/55"></div>

  <div class="relative z-10 flex h-full items-center">
    <!-- <div class="mx-auto w-full max-w-7xl px-6"> -->
    <Container>
      <div class="max-w-3xl text-center lg:text-left">
        <p class="mb-5 uppercase tracking-[0.4em] text-amber-400 font-semibold">
          Welcome
        </p>

        <h1
          class="text-4xl
sm:text-5xl
lg:text-7xl font-black text-white leading-tight"
        >
          {localize(slide.title, Astro.locals.language)}
        </h1>

        <p
          class="mt-8 text-slate-200 text-base
leading-8
sm:text-lg
lg:text-xl
lg:leading-9"
        >
          {localize(slide.subtitle, Astro.locals.language)}
        </p>

        <!-- <div class="mt-12 flex flex-wrap gap-5"> -->
        <div
          class="mt-10
flex
flex-col
sm:flex-row
justify-center
lg:justify-start
gap-4"
        >
          <!-- <a
            href={slide.primaryButton.href}
            class="rounded-lg bg-amber-500 px-8 py-4 font-semibold text-white hover:bg-amber-600 transition"
          >
            {slide.primaryButton.label}
          </a> -->
          <Button href={slide.primaryButton.href}>
            {localize(slide.primaryButton.label, Astro.locals.language)}
          </Button>

          <!-- <a
            href={slide.secondaryButton.href}
            class="rounded-lg border border-white px-8 py-4 font-semibold text-white hover:bg-white hover:text-black transition"
          >
            {slide.secondaryButton.label}
          </a> -->
          <Button href={slide.secondaryButton.href} variant="secondary">
            {localize(slide.secondaryButton.label, Astro.locals.language)}
          </Button>
        </div>
      </div>
    </Container>
    <!-- </div> -->
  </div>
</div>
