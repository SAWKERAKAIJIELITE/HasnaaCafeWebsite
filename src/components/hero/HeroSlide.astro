---
import type { HeroSlide as HeroSlideType } from "@/data/hero";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { Image } from "astro:assets";

interface Props {
  slide: HeroSlideType;
}

const { slide } = Astro.props;
---

<!-- <div class="relative h-screen w-full shrink-0"> -->
<div class="embla__slide relative min-h-screen">
  {
    slide.type === "image" && (
      <Image
        src={slide.media}
        alt={slide.title}
        widths={[640, 1024, 1440, 1920]}
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover"
      />
    )
  }

  {
    slide.type === "video" && (
      <video
        autoplay
        muted
        loop
        playsinline
        class="absolute inset-0 h-full w-full object-cover"
      >
        <source src={slide.media} />
      </video>
    )
  }

  <div class="absolute inset-0 bg-black/55"></div>

  <div class="relative z-10 flex h-full items-center">
    <!-- <div class="mx-auto w-full max-w-7xl px-6"> -->
    <Container>
      <div class="max-w-3xl">
        <p class="mb-5 uppercase tracking-[0.4em] text-amber-400 font-semibold">
          Welcome
        </p>

        <h1 class="text-5xl md:text-7xl font-black text-white leading-tight">
          {slide.title}
        </h1>

        <p class="mt-8 text-xl text-slate-200 leading-9">
          {slide.subtitle}
        </p>

        <div class="mt-12 flex flex-wrap gap-5">
          <!-- <a
            href={slide.primaryButton.href}
            class="rounded-lg bg-amber-500 px-8 py-4 font-semibold text-white hover:bg-amber-600 transition"
          >
            {slide.primaryButton.label}
          </a> -->
          <Button href={slide.primaryButton.href}>
            {slide.primaryButton.label}
          </Button>

          <!-- <a
            href={slide.secondaryButton.href}
            class="rounded-lg border border-white px-8 py-4 font-semibold text-white hover:bg-white hover:text-black transition"
          >
            {slide.secondaryButton.label}
          </a> -->
          <Button href={slide.secondaryButton.href} variant="secondary">
            {slide.secondaryButton.label}
          </Button>
        </div>
      </div>
    </Container>
    <!-- </div> -->
  </div>
</div>
