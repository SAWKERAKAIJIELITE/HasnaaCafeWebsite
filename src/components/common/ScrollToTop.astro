---
import { ArrowUp } from "lucide-astro";
---

<!-- bg-amber-500 -->
<button
  id="scroll-to-top"
  type="button"
  aria-label="Scroll back to top"
  title="Back to top"
  class="scroll-top"
>
  <svg
    class="scroll-top__svg"
    width="56"
    height="56"
    viewBox="0 0 56 56"
    aria-hidden="true"
  >
    <circle class="scroll-top__track" cx="28" cy="28" r="24"></circle>

    <circle
      id="scroll-progress"
      class="scroll-top__progress"
      cx="28"
      cy="28"
      r="24"></circle>
  </svg>

  <span class="scroll-top__icon">
    <ArrowUp size={20} />
  </span>
  <!-- <ArrowUp size={24} /> -->
</button>
