---
import PackageChip from "./PackageChip.astro";
import ProductBadge from "./ProductBadge.astro";
import ArrowLink from "./ArrowLink.astro";
import { localize } from "@/i18n/localize";

const imgs = import.meta.glob(
  "/src/content/products/**/*.{jpg,jpeg,png,gif,webp,avif}",
  { eager: true, import: "default" },
);

const originsDict = {
  Brazil: { ar: "البرازيل", en: "Brazil" },
  Colombia: { ar: "كولومبيا", en: "Colombia" },
  Ceylon: { ar: "سيلان", en: "Ceylon" },
  Ethiopia: { ar: "إثيوبيا", en: "Ethiopia" },
  Yemen: { ar: "يمن", en: "Yemen" },
  Arabic: { ar: "عربي", en: "Arabic" },
  China: { ar: "الصين", en: "China" },
  // "": { ar: "", en: "", },
};
const { featured } = Astro.props;
---

<section class="mt-20 reveal" data-featured-product>
  <div
    data-featured-content
    class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_30px_80px_rgba(0,0,0,.08)]"
  >
    <!-- <div class="grid min-h-[500px] lg:grid-cols-2"> -->
    <div class="grid min-h-[420px] lg:h-[520px] lg:grid-cols-[48%_52%]">
      <!-- Image -->
      <div
        class="relative overflow-hidden bg-slate-100 h-[320px] lg:h-full flex items-center justify-center"
      >
        <img
          data-featured-image
          src={imgs[
            `/src/content/products/${featured.id}/${featured.thumbnail}`
          ].src}
          alt={featured.name_en}
          class="h-full w-full object-cover transition duration-700 hover:scale-105 object-center"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/25 to-transparent"
        >
        </div>
      </div>

      <div class="flex flex-col justify-center p-8 lg:p-10">
        <!-- <span
          class="text-sm font-bold uppercase tracking-[.3em] text-[#fdb913]"
        >
          Featured Product
        </span> -->
        <ProductBadge label="Featured Product" />

        <h3
          data-featured-title
          class="mt-5 lg:text-[2rem] text-3xl font-black text-slate-900"
        >
          {
            localize(
              { ar: featured.name, en: featured.name_en },
              Astro.locals.language,
            )
          }
        </h3>

        <p
          data-featured-description
          class="mt-5 leading-7 line-clamp-3 text-slate-600"
        >
          {localize(featured.description, Astro.locals.language)}
        </p>

        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          <div>
            <p class="text-xs uppercase tracking-[.25em] text-slate-400">
              Origin
            </p>

            <p data-featured-origin class="mt-2 font-semibold text-slate-800">
              {featured.origin ? localize(originsDict[featured.origin], Astro.locals.language) : "-"}
            </p>
          </div>

          <!-- <div>
            <p class="text-xs uppercase tracking-[.25em] text-slate-400">
              Roast
            </p>

            <p data-featured-roast class="mt-2 font-semibold text-slate-800">
              {featured.roastLevel}
            </p>
          </div> -->
        </div>

        <!-- Packages -->

        <div class="mt-8">
          <p class="mb-4 text-xs uppercase tracking-[.25em] text-slate-400">
            Packaging
          </p>

          <div data-featured-packages class="flex flex-wrap gap-3">
            {
              featured.packaging.map((pkg) => (
                <PackageChip label={`${pkg.amount} ${pkg.unit}`} />
              ))
            }
          </div>
        </div>

        <!-- Applications -->

        <!-- <div class="mt-10">
          <p class="mb-4 text-xs uppercase tracking-[.25em] text-slate-400">
            Applications
          </p>

          <div data-featured-applications class="flex flex-wrap gap-3">
            {
              featured.applications.map((application) => (
                <span class="rounded-full border border-[#005826]/20 bg-[#005826]/5 px-4 py-2 text-sm font-medium text-[#005826]">
                  {application}
                </span>
              ))
            }
          </div>
        </div> -->
        <ArrowLink href="#contact" label="View Details →" />
      </div>
    </div>
  </div>
</section>
