---
import { localize } from "@/i18n/localize";

const categories = [
  {
    id: "coffee-beans",
    icon: "☕",
    title: { en: "Coffee Beans", ar: "بن" },
  },
  {
    id: "liquid-coffee",
    icon: "🥤",
    title: { en: "Liquid Coffee", ar: "قهوة سائلة" },
  },
  {
    id: "tea",
    icon: "🍵",
    title: { en: "Tea", ar: "شاي" },
  },
  {
    id: "chocolate",
    icon: "🍫",
    title: { en: "Chocolate", ar: "شوكولا" },
  },
];
---

<div class="mt-20 flex flex-wrap justify-center gap-4">
  {
    categories.map((category) => (
      <button
        class="product-category group"
        data-category-button
        data-category={category.id}
      >
        <span class="text-2xl">{category.icon}</span>
        <span>{localize(category.title, Astro.locals.language)}</span>
      </button>
    ))
  }
</div>
