---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="inline-flex
        w-fit
        items-center
        rounded-full
        bg-[#005826]/10
        px-3
        py-1
        text-xs
        font-bold
        uppercase
        tracking-[.18em]
        text-[#005826]"
>
  {label}
</span>
