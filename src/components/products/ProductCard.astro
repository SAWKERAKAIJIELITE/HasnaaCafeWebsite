---
import PackageChip from "./PackageChip.astro";
import ProductBadge from "./ProductBadge.astro";
import { localize } from "@/i18n/localize";
import type { Product } from "@/types/product";

const imgs = import.meta.glob(
  "/src/content/products/**/*.{jpg,jpeg,png,gif,webp,avif}",
  { eager: true, import: "default" },
);

interface Props {
  product: Product;
}
const { product } = Astro.props;
---

<article
  class="group
        overflow-hidden
        rounded-[1.75rem]
        border
        border-slate-200
        bg-white
        transition-all
        duration-500
        hover:-translate-y-2
        hover:border-[#005826]/20
        hover:shadow-[0_30px_70px_rgba(0,0,0,.12)]"
>
  <div class="relative overflow-hidden bg-slate-100">
    <img
      src={imgs[`/src/content/products/${product.id}/${product.thumbnail}`].src}
      alt={product.name_en}
      class="h-72 w-full object-cover transition-transform duration-700 group-hover:scale-110"
    />

    <div class="absolute inset-0 bg-gradient-to-t from-black/10 to-transparent">
    </div>
  </div>

  <!-- Content -->
  <div class="p-7">
    <ProductBadge label={product.category} />

    <h3 class="mt-5 text-2xl font-black text-slate-900">
      {
        localize(
          { ar: product.name, en: product.name_en },
          Astro.locals.language,
        )
      }
    </h3>

    <p class="mt-4 line-clamp-3 leading-7 text-slate-600">
      {localize(product.description, Astro.locals.language)}
    </p>

    <div class="mt-6 flex flex-wrap gap-2">
      {
        product.packaging.map((pkg) => (
          <PackageChip label={`${pkg.amount} ${pkg.unit}`} />
        ))
      }
    </div>

    <div class="mt-8">
      <button
        class="group
        inline-flex
        items-center
        gap-2
        font-semibold
        text-[#005826]"
        data-product-id={product.id}
        data-product-open
      >
        <span> View Details </span>
        <span
          class="transition-transform duration-300 group-hover:translate-x-1"
        >
          →
        </span>
      </button>
    </div>
  </div>
</article>
