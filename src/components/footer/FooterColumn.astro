---
import { localize } from "@/i18n/localize";

const {data, title } = Astro.props;
---

<div>
  <h3 class="mb-6 text-lg font-bold text-white">
    {title}
  </h3>

  <ul class="space-y-4">
    {
      data.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-slate-300 transition-colors duration-300 hover:text-amber-400"
          >
            {localize(link.label,Astro.locals.language)}
          </a>
        </li>
      ))
    }
  </ul>
</div>
