---
import type { FooterColumn } from "@/types/footer";

interface Props {
    column: FooterColumn;
}

const { column } = Astro.props;
---

<div>
    <h3 class="mb-6 text-lg font-bold text-white">
        {column.title}
    </h3>

    <ul class="space-y-4">
        {
            column.links.map((link) => (
                <li>
                    <a href={link.href} class="text-slate-300 transition-colors duration-300 hover:text-amber-400">
                        {link.label}
                    </a>
                </li>
            ))
        }
    </ul>
</div>