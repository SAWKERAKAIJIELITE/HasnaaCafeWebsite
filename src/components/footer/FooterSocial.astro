---
import { contactRepository } from "@/services/home/contact.service";
import { Facebook, Instagram, Linkedin, Send } from "lucide-astro";


const socials = (await contactRepository.get()).socials;
const social = [
  {
    href: socials.find((s) => s.type == "facebook").link,
    icon: Facebook,
    label: "Facebook",
  },
  {
    href: socials.find((s) => s.type == "instagram").link,
    icon: Instagram,
    label: "Instagram",
  },
  {
    href: socials.find((s) => s.type == "telegram").link,
    icon: Send,
    label: "Telegram",
  },
  {
    href: socials.find((s) => s.type == "linkedin").link,
    icon: Linkedin,
    label: "Linkedin",
  },
];
---

<div class="mt-10 flex gap-4">
  {
    social.map((item) => {
      const Icon = item.icon;
      return (
        <a
          href={item.href}
          aria-label={item.label}
          target="_blank"
          rel="noopener noreferrer"
          class="flex
                        h-11
                        w-11
                        items-center
                        justify-center

                        rounded-full

                        bg-white/5

                        transition-all
                        duration-300

                        hover:-translate-y-1
                        hover:bg-amber-500
                    "
        >
          <Icon size={18} />
        </a>
      );
    })
  }
</div>
