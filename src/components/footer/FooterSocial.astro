---
import { socialLinks } from "@/data/footer";
---

<div class="mt-10 flex gap-4">
  {
    socialLinks.map((item) => {
      const Icon = item.icon;
      return (
        <a
          href={item.href}
          aria-label={item.label}
          target="_blank"
          rel="noopener noreferrer"
          class="flex
                        h-11
                        w-11
                        items-center
                        justify-center

                        rounded-full

                        bg-white/5

                        transition-all
                        duration-300

                        hover:-translate-y-1
                        hover:bg-amber-500
                    "
        >
          <Icon size={18} />
        </a>
      );
    })
  }
</div>
