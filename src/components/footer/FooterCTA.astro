---

---

<section
  class="relative
        overflow-hidden
        rounded-[2rem]
        bg-gradient-to-r
        from-amber-500
        via-amber-600
        to-amber-700
        px-8
        py-16
        text-center
        shadow-2xl"
  data-animate="fade-up"
>
  <!-- Decorative circles -->

  <div aria-hidden="true" class="absolute -right-20 -top-20 h-72 w-72 rounded-full bg-white/10">
  </div>

  <div aria-hidden="true" class="absolute -bottom-16 -left-16 h-56 w-56 rounded-full bg-white/5">
  </div>

  <div class="relative z-10">
    <p class="uppercase tracking-[0.35em] text-white/80">
      Let's Work Together
    </p>

    <h2 class="mx-auto mt-5 max-w-3xl text-4xl font-black text-white lg:text-5xl">
      Ready to Elevate Your Coffee Business?
    </h2>

    <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-white/90">
      Partner with Hasnaa Coffee for premium products, dependable service and
      long-term success.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-5">
      <a
        href="#contact"
        class="rounded-xl
                    bg-white
                    px-8
                    py-4
                    font-semibold
                    text-slate-900
                    transition-all
                    duration-300
                    hover:-translate-y-1
                    hover:shadow-xl"
      >
        Contact Us
      </a>

      <a
        href="#products"
        class="rounded-xl
                    border
                    border-white/50
                    px-8
                    py-4
                    font-semibold
                    text-white
                    transition-all
                    duration-300
                    hover:bg-white/10"
      >
        Explore Products
      </a>
    </div>
  </div>
</section>
