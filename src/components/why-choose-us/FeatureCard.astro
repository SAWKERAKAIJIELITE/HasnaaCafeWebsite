---
interface Props {
  title: string;
  description: string;
  icon: any;
}

const { title, description, icon: Icon } = Astro.props;
---

<article
  class="group
  flex
  h-full
  flex-col
  rounded-2xl
  border
  border-slate-200
  bg-white
  p-8
  transition-all
  duration-300
  hover:-translate-y-2
  hover:border-amber-400
  hover:shadow-[0_24px_60px_rgba(245,158,11,0.18)]
  focus-within:-translate-y-2
  focus-within:border-amber-400
  focus-within:shadow-[0_24px_60px_rgba(245,158,11,0.18)]
  ease-out"
  data-animate="fade-up"
>
  <div
    class="mb-8
    flex
    h-16
    w-16
    items-center
    justify-center
    rounded-xl
    bg-amber-100
    transition-transform
    duration-300
    group-hover:scale-110
    group-hover:rotate-6
    group-hover:bg-amber-500
    group-focus-within:bg-amber-500"
  >
    <Icon
      class="text-amber-600 transition-all duration-300 group-hover:text-white group-focus-within:text-white"
      size={34}
      strokeWidth={2}
    />
  </div>

  <h3 class="mb-5 text-xl font-bold text-slate-900">
    {title}
  </h3>

  <p class="flex-1 text-base leading-7 text-slate-600">
    {description}
  </p>
</article>
