<section
  id="offers"
  class="relative scroll-mt-24 overflow-hidden bg-[#1C1410] px-6 py-20 md:py-28"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(172,135,89,0.12),_transparent_60%)]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl">
    <div class="mb-14 max-w-xl md:mb-20">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-[#AC8759]">
        At the Counter
      </p>
      <h2
        class="mt-4 font-serif text-4xl leading-tight text-[#F2E8D8] md:text-5xl"
      >
        Offers worth <em class="text-[#AC8759] not-italic">the stop</em>.
      </h2>
      <p class="mt-4 font-sans text-base leading-relaxed text-[#F2E8D8]/70">
        Three ways to drink better for less, this month only. Flip a ticket to
        see the offer — redeem in-store or online, no code needed.
      </p>
    </div>

    <ul class="grid gap-8 md:grid-cols-3">
      {
        offers.map((offer, i) => {
          const ticketNumber = `No. ${String(i + 1).padStart(2, "0")}`;
          return (
            <li class="list-none">
              <div
                class="flip-scene group relative aspect-[3/4] w-full cursor-pointer rounded-lg outline-none transition-transform duration-300 hover:-translate-y-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#AC8759] motion-reduce:transition-none"
                data-flip-scene
                role="button"
                tabindex="0"
                aria-pressed="false"
                aria-label={`Flip to reveal the ${offer.data.title} offer`}
              >
                <div
                  class="flip-card relative h-full w-full rounded-lg shadow-[0_18px_40px_-20px_rgba(0,0,0,0.6)]"
                  data-flip-card
                >
                  {/* BACK — visible at rest */}
                  <div class="flip-face flip-face--back absolute inset-0 flex h-full flex-col items-center justify-center gap-4 overflow-hidden rounded-lg bg-[#3B2A1F] p-6 text-center">
                    <span class="font-mono text-xs tracking-widest text-[#F2E8D8]/50">
                      {ticketNumber}
                    </span>
                    <span class="flex h-24 w-24 rotate-[-6deg] items-center justify-center rounded-full border-2 border-[#8C3B2E] px-2 text-center font-mono text-base font-bold uppercase leading-tight tracking-wide text-[#F2E8D8]">
                      {offer.data.stamp}
                    </span>
                    <p class="font-serif text-lg text-[#F2E8D8]">
                      {offer.data.title}
                    </p>
                    <span class="mt-1 inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.2em] text-[#AC8759]">
                      <svg
                        viewBox="0 0 24 24"
                        class="h-3 w-3"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <polyline points="23 4 23 10 17 10" />
                        <polyline points="1 20 1 14 7 14" />
                        <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
                      </svg>
                      Tap to reveal
                    </span>
                  </div>

                  {/* FRONT — visible after flip */}
                  <article class="flip-face flip-face--front absolute inset-0 flex h-full flex-col overflow-hidden rounded-lg bg-[#F2E8D8]">
                    <div class="relative h-2/5 flex-none overflow-hidden bg-[#1C1410]/10">
                      <img
                        src={`src/content/offers/${offer.id}/${offer.data.image}`}
                        alt={offer.data.title}
                        // widths={[400, 800]}
                        sizes="(min-width: 768px) 33vw, 100vw"
                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                      />
                      <div
                        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1C1410]/35 via-transparent to-transparent"
                        aria-hidden="true"
                      />
                      <span class="absolute left-3 top-3 rounded-full bg-[#1C1410]/60 px-3 py-1 font-mono text-xs tracking-widest text-[#F2E8D8] backdrop-blur-sm">
                        {ticketNumber}
                      </span>
                      <span class="absolute -right-2 -top-2 rotate-[-8deg] rounded-full border-[1.5px] border-[#8C3B2E] bg-[#F2E8D8] px-3 py-1.5 font-mono text-[11px] font-bold uppercase tracking-wide text-[#8C3B2E] shadow-md">
                        {offer.data.stamp}
                      </span>
                    </div>

                    <div
                      class="relative border-t-2 border-dashed border-[#1C1410]/20"
                      aria-hidden="true"
                    >
                      <span class="absolute -left-3 top-1/2 h-6 w-6 -translate-y-1/2 rounded-full bg-[#1C1410]" />
                      <span class="absolute -right-3 top-1/2 h-6 w-6 -translate-y-1/2 rounded-full bg-[#1C1410]" />
                    </div>

                    <div class="flex flex-1 flex-col gap-2 overflow-hidden px-5 pb-5 pt-4">
                      <h3 class="line-clamp-1 font-serif text-lg font-semibold leading-snug text-[#1C1410]">
                        {offer.data.title}
                      </h3>
                      <p class="line-clamp-3 flex-1 font-sans text-sm leading-relaxed text-[#1C1410]/70">
                        {offer.data.description}
                      </p>
                      <div class="mt-auto flex items-center justify-between border-t border-[#1C1410]/10 pt-3">
                        <span class="font-mono text-[11px] uppercase tracking-wide text-[#1C1410]/50">
                          {offer.data.expiry}
                        </span>
                        <a
                          href={offer.data.href}
                          class="rounded-full border border-[#1C1410] px-4 py-2 font-sans text-sm font-medium text-[#1C1410] transition-colors hover:bg-[#1C1410] hover:text-[#F2E8D8] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#AC8759]"
                        >
                          Redeem offer
                        </a>
                      </div>
                    </div>
                  </article>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>

    <p
      class="mt-10 text-center font-mono text-[11px] uppercase tracking-widest text-[#F2E8D8]/40"
    >
      One offer per order · Cannot be combined · Prices in local currency
    </p>
  </div>
</section>

<style>
  .flip-scene {
    perspective: 1600px;
  }
  .flip-card {
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.65, 0, 0.35, 1);
  }
  @media (hover: hover) {
    .flip-scene:hover .flip-card {
      transform: rotateY(180deg);
    }
  }
  .flip-scene.is-flipped .flip-card {
    transform: rotateY(180deg);
  }
  .flip-face {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .flip-face--front {
    transform: rotateY(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .flip-card {
      transition: none;
    }
  }
</style>

<script>
  const scenes = document.querySelectorAll("[data-flip-scene]");

  scenes.forEach((scene) => {
    const toggle = () => {
      const flipped = scene.classList.toggle("is-flipped");
      scene.setAttribute("aria-pressed", String(flipped));
    };

    scene.addEventListener("click", (event) => {
      // Let the CTA link navigate instead of re-flipping the card.
      const target = event.target;
      if (target.closest && target.closest("a")) return;
      toggle();
    });

    scene.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        toggle();
      }
    });
  });
</script>
