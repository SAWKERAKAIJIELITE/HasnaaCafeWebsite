                rotations[i % rotations.length],
              ]}
            >
              {/* stub */}
              <div class="flex items-start justify-between px-5 pt-5 pb-4">
                <span class="font-mono text-xs tracking-widest text-[#1C1410]/50">
                  {offer.number}
                </span>
                <span class="rounded-full border-[1.5px] border-[#8C3B2E] px-2.5 py-1 rotate-[-8deg] font-mono text-[11px] font-bold uppercase tracking-wide text-[#8C3B2E] opacity-90 mix-blend-multiply">
                  {offer.stamp}
                </span>
              </div>

              {/* perforation with ticket notches */}
              <div
                class="relative border-t-2 border-dashed border-[#1C1410]/20"
                aria-hidden="true"
              >
                <span class="absolute -left-3 top-1/2 h-6 w-6 -translate-y-1/2 rounded-full bg-[#1C1410]" />
                <span class="absolute -right-3 top-1/2 h-6 w-6 -translate-y-1/2 rounded-full bg-[#1C1410]" />
              </div>

              {/* body */}
              <div class="flex flex-1 flex-col gap-3 px-5 pb-6 pt-5">
                <h3 class=" text-xl font-semibold text-[#1C1410]">
                  {offer.title}
                </h3>
                <p class="flex-1 font-sans text-sm leading-relaxed text-[#1C1410]/70">
                  {offer.description}
                </p>
                <div class="mt-2 flex items-center justify-between border-t border-[#1C1410]/10 pt-4">
                  <span class="font-mono text-[11px] uppercase tracking-wide text-[#1C1410]/50">
                    {offer.expiry}
                  </span>
                  <a
                    href={offer.href}
                    class="rounded-full border border-[#1C1410] px-4 py-2 font-sans text-sm font-medium text-[#1C1410] transition-colors hover:bg-[#1C1410] hover:text-[#F2E8D8] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#AC8759]"
                  >
                    Redeem offer
