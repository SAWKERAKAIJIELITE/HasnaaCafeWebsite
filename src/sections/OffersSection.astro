                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <p
      class="mt-10 text-center font-mono text-[11px] uppercase tracking-widest text-[#F2E8D8]/40"
    >
      One offer per order · Cannot be combined · Prices in local currency
    </p>
  </div>
