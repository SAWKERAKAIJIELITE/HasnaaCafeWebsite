---
// ManagementCouncilSection.astro
// Drop into src/components/ and use in a page: <ManagementCouncilSection />
//
// Data now comes from the "council" Content Collection (see the
// keystatic.config.ts / content.config.ts snippets shared alongside this
// file) so editors can add/edit/reorder council members from the Keystatic
// admin, same pattern as the offers section.
//
// Fonts: assumes  -> Fraunces, font-sans -> Manrope,
//  -> IBM Plex Mono, matching the rest of the site.

import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const members = await getCollection("council",({ data }) => data.published,);

import "@/styles/global.css";
---

