  <div class="relative mx-auto max-w-6xl">
    <div class="mb-14 max-w-xl md:mb-20">
      <p class=" text-xs uppercase tracking-[0.25em] text-[#AC8759]">
        Leadership
      </p>
      <h2
        class="mt-4  text-4xl leading-tight text-[#F2E8D8] md:text-5xl"
      >
        The council behind <em class="text-[#AC8759] not-italic">the cup</em>.
      </h2>
      <p class="mt-4 font-sans text-base leading-relaxed text-[#F2E8D8]/70">
        A small group of roasters, operators, and organizers who've spent their
        careers making sure every cup meets the same standard.
      </p>
    </div>

    <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        members.map((member) => (
          <li class="list-none">
            <article class="group flex h-full flex-col overflow-hidden rounded-lg border border-[#AC8759]/15 bg-[#241A14] shadow-[0_18px_40px_-24px_rgba(0,0,0,0.7)] transition-transform duration-300 hover:-translate-y-1 motion-reduce:transition-none">
              <div class="relative aspect-[4/5] overflow-hidden">
                <img
                  src={`src/content/council/${member.id}/${member.data.image}`}
                  alt={member.data.name}

                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  class="h-full w-full object-cover sepia-[0.15] contrast-[1.05] transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                />
