                  aria-hidden="true"
                />
              </div>

              {/* brass nameplate, overlapping the photo like a museum placard */}
              <div class="relative -mt-8 mx-6 rounded-md bg-gradient-to-b from-[#D3B27C] to-[#9C7A4C] px-4 py-3 shadow-lg">
